<!--
  tjark_agv Gazebo 启动（本项目封装，不修改 tjark_agv 源码）。

  WSL2 下默认 tjark_agv.launch 的 cafe.world 加载很慢（可达数分钟），
  gzclient 也常因显示问题卡住。推荐：

    roslaunch ai_robot_nav tjark_gazebo.launch headless:=true

  无 GUI 时 gzserver 仍发布 /scan、/my_camera/color/image_raw、/cmd_vel，
  可直接启动 AI 导航节点。
-->
<launch>
  <arg name="headless" default="true"/>
  <arg name="world_name" default="$(find gazebo_ros)/worlds/empty.world"/>
  <arg name="paused" default="false"/>
  <arg name="use_sim_time" default="true"/>
  <arg name="gui" default="false"/>

  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(arg world_name)"/>
    <arg name="paused" value="$(arg paused)"/>
    <arg name="use_sim_time" value="$(arg use_sim_time)"/>
    <arg name="headless" value="$(arg headless)"/>
    <arg name="gui" value="$(arg gui)"/>
  </include>

  <param name="robot_description"
         command="$(find xacro)/xacro $(find tjark_agv)/urdf/tjark_agv.xacro"/>

  <node pkg="gazebo_ros" type="spawn_model" name="spawn_urdf"
        args="-urdf -model tjark_agv -x 0 -y 0 -z 0.4 -R 0 -P 0 -Y 0 -param robot_description"
        output="screen"/>

  <node name="robot_state_publisher" pkg="robot_state_publisher"
        type="robot_state_publisher" output="screen"/>

  <rosparam file="$(find tjark_agv)/urdf/tjark_agv.controller.yaml" command="load"/>
</launch>
