<!-- 一键仿真：Gazebo（默认无 GUI 空场景）+ AI 导航 -->
<launch>
  <arg name="headless" default="true"/>
  <arg name="gui" default="false"/>
  <arg name="use_image" default="true"/>
  <arg name="params_file" default="$(find ai_robot_nav)/config/tjark_agv_params.yaml"/>

  <include file="$(find ai_robot_nav)/launch/tjark_gazebo.launch">
    <arg name="headless" value="$(arg headless)"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="use_sim_time" value="true"/>
  </include>

  <include file="$(find ai_robot_nav)/launch/ai_nav.launch">
    <arg name="use_sim_time" value="true"/>
    <arg name="use_image" value="$(arg use_image)"/>
    <arg name="params_file" value="$(arg params_file)"/>
  </include>
</launch>
